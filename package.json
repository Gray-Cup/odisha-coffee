{
  "name": "graycup-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "prebuild": "react-router typegen && (bun run scripts/fetch-graycup-products.ts || echo 'graycup feed fetch failed, using committed copy') && bun run scripts/generate-sitemap.ts",
    "generate-sitemap": "bun run scripts/generate-sitemap.ts",
    "fetch-graycup": "bun run scripts/fetch-graycup-products.ts",
    "build": "react-router build",
    "typecheck": "react-router typegen && tsc -p tsconfig.cloudflare.json",
    "format": "prettier --write .",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "preview": "wrangler dev",
    "deploy": "react-router build && wrangler deploy",
    "convert-images": "node scripts/convert-images-to-webp.mjs --all",
    "generate-llms-full": "node scripts/generate-llms-full.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1104.0",
    "@aws-sdk/s3-presigned-post": "^3.1104.0",
    "@hookform/resolvers": "^5.2.2",
    "@intercom/messenger-js-sdk": "^0.0.18",
    "@libsql/client": "^0.17.4",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@t3-oss/env-nextjs": "^0.13.8",
    "better-auth": "^1.4.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.23.26",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "isbot": "5.1.32",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.562.0",
    "next": "^16.3.0",
    "next-llms-generator": "^0.1.0",
    "next-mdx-remote": "^6.0.0",
    "next-sitemap": "^4.2.3",
    "next-themes": "^0.4.6",
    "nextra": "^4.6.1",
    "nextra-theme-docs": "^4.6.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.68.0",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-router": "7.9.6",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "resend": "^6.18.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "wrangler": "^4.86.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.15.3",
    "@mdx-js/rollup": "^3.1.1",
    "@react-router/dev": "7.9.6",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "^20.19.26",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.25.4",
    "husky": "^9.1.7",
    "prettier": "3.6.2",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vite-tsconfig-paths": "5.1.4"
  }
}
