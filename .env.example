# Legacy Postgres (Neon) — pre-D1-migration orders archive only, not read
# by the app anymore. Orders now live in D1 (GRAYCUP_ORDERS_DB binding,
# see wrangler.jsonc).
DATABASE_URL=

# Cashfree — payment gateway. CASHFREE_CLIENT_SECRET also verifies the
# PAYMENT_SUCCESS webhook (/api/webhooks/cashfree) — register that endpoint
# in the Cashfree dashboard → Developers → Webhooks.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=

# Shared secret guarding /api/internal/* — lets orders-graycup (a plain Node
# app with no direct D1 access) read/update orders over HTTPS.
INTERNAL_API_SECRET=

# Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend — order confirmation emails
RESEND_API_KEY=
RESEND_FROM_EMAIL="Odisha Coffee <orders@odishacoffee.com>"

# Turso (libsql) — reviews database, shared with orders-graycup for moderation
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Backblaze B2 — review photo storage (S3-compatible API)
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_ENDPOINT=
B2_REGION=
B2_PUBLIC_BASE_URL=
